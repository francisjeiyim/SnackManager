# Copy to packages/server/.env for local dev (server / client-server mode).
NODE_ENV=development
SERVER_PORT=4100
DATABASE_URL=postgresql://snackmanager:snackmanager@localhost:5434/snackmanager?schema=public

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

CORS_ORIGINS=http://localhost:5273

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin1234

# e2e tests use their own database (override if needed):
# DATABASE_URL_TEST=postgresql://snackmanager:snackmanager@localhost:5434/snackmanager_test?schema=public
