# ---------------------------------------------------------------------------
# SnackManager — environment (server mode / dev infra)
# Copy to .env and adjust. The autonomous (offline) mode needs none of this.
# ---------------------------------------------------------------------------

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=snackmanager
POSTGRES_PASSWORD=snackmanager
POSTGRES_DB=snackmanager
POSTGRES_PORT=5434

# --- Server (@snackmanager/server) ---
NODE_ENV=development
SERVER_PORT=4100
DATABASE_URL=postgresql://snackmanager:snackmanager@localhost:5434/snackmanager?schema=public

# Auth
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# CORS: comma-separated origins allowed to call the API / open a socket
CORS_ORIGINS=http://localhost:5273

# Default seeded admin (server mode)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin1234

# --- Web app (@snackmanager/app) ---
# Baked at build time by Vite. Leave empty to start in autonomous (offline) mode.
VITE_API_URL=http://localhost:4100
VITE_DEFAULT_MODE=server
