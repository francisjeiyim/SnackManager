# SnackManager — test deployment. Copy to .env.prod and fill in, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# .env.prod is git-ignored — never commit real secrets.

# Public origin — used BOTH for the API CORS allow-list AND baked into the SPA
# bundle as VITE_API_URL. Must match the tunnel's DNS route exactly.
PUBLIC_ORIGIN=https://snack.ciskolabtech.net

# --- PostgreSQL (internal to the compose network, not published) ---
POSTGRES_USER=snackmanager
POSTGRES_PASSWORD=
POSTGRES_DB=snackmanager

# --- JWT secrets — generate each with:  openssl rand -hex 32 ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Admin account, (re)asserted by the seed on every boot ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# --- Dedicated Cloudflare Tunnel (see docs/DEPLOY.md) ---
#   cloudflared tunnel create snackmanager
#   cloudflared tunnel route dns snackmanager snack.ciskolabtech.net
# CLOUDFLARE_TUNNEL_ID  = the UUID printed by `tunnel create`
# CLOUDFLARED_CREDENTIALS_PATH = the <uuid>.json it wrote under ~/.cloudflared
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARED_CREDENTIALS_PATH=C:/Users/francis/.cloudflared/REPLACE_WITH_TUNNEL_ID.json
